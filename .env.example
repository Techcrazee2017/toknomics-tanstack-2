# ============================================================================
# TokNomics — Environment Variables
# Copy to .env and fill with real values
# ============================================================================

# ==========================================
# 1. SUPABASE CLIENT KEYS (Frontend / Vite)
# ==========================================
# Your Supabase project URL (https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Publishable/anon key (safe for client-side) — new format: sb_publishable_...
# Also supports legacy VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# App URL for OAuth redirects
VITE_APP_URL=https://toknomics.vibepreview.com

# ==========================================
# 2. SUPABASE ADMIN KEYS (Ingestion Worker ONLY)
# ==========================================
# ⚠️  SECURITY: These keys are for the backend WebSocket worker ONLY.
# They must NEVER be prefixed with VITE_ — Vite only exposes VITE_-prefixed
# variables to the client bundle. The service role key bypasses all RLS
# policies and must never reach the frontend.
# Keep these in a separate .env file for the worker, or ensure your CI/CD
# pipeline injects them only into the worker service container.
SUPABASE_URL=https://your-project-id.supabase.co
# Service role key — bypasses RLS, used ONLY by the WebSocket ingestion worker
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ==========================================
# 3. EULER STREAM CREDENTIALS
# ==========================================
# API key for the Euler Stream WebSocket service (https://eulerstream.com)
EULER_API_KEY=your_euler_stream_api_key

# ==========================================
# 4. WORKER CONFIGURATION (optional)
# ==========================================
# Polling interval in seconds for checking tracked_targets
WORKER_POLL_INTERVAL_SECONDS=60
# Max concurrent WebSocket connections
WORKER_MAX_CONNECTIONS=100
